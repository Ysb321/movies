# Get a free key at https://www.themoviedb.org/settings/api
# Used by the backend proxy (/api/tmdb/*)
TMDB_API_KEY=your_tmdb_v3_api_key

# Same key, exposed to the browser as a fallback when the backend proxy
# cannot reach TMDB (e.g. static hosting without server functions).
NEXT_PUBLIC_TMDB_API_KEY=your_tmdb_v3_api_key

# Optional — Server 18 (Licensed Anime). With a YouTube Data API v3 key
# the lane resolves episodes via the documented search.list endpoint;
# without one it falls back to parsing the channel search page.
# Get one at https://console.cloud.google.com/apis/library/youtube.googleapis.com
YOUTUBE_API_KEY=

# Optional — extra OFFICIAL licensor channels for Server 18, as
# "Name:ChannelId" pairs. Only add channels operated by the rightsholder
# or their appointed licensee. See docs/licensed-anime.md.
LICENSED_ANIME_CHANNELS=
